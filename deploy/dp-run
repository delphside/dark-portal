#!/usr/bin/env bash
# Runs one `dp` job in the release's image, as the systemd units do
# (docs/5.1.3 *Scheduling*).
#
#   dp-run SUBCOMMAND [ARGUMENT...]
#   dp-run --help
#
# SUBCOMMAND is one of dp's (hourly, collect, items, transform, export, daily,
# probe); the arguments after it go to `dp`, not to docker.
#
# The environment is the caller's: the unit loads the environment's `.env`
# with `EnvironmentFile=`, and this script passes the same file to the
# container. It reads DP_IMAGE (the release's image, name and tag), DP_ENV_FILE
# (that `.env`, named `<env>.env`: the container is named `dp-SUBCOMMAND-<env>`),
# DP_RUN_USER (`uid:gid`, the environment's user), DP_CONTAINER_MEMORY,
# DP_DATA_DIR, DP_LOCK_FILE, DP_BLIZZARD_CLIENT_SECRET_FILE and, where DP_BUCKET
# is set, DP_BUCKET_ACCESS_FILE (docs/5.4.1). Run it as the unit does, with a
# clean environment. It creates nothing: the lock file must exist already
# (docs/5.3.2).
#
# Exits (programme docs/1.10 *What a script's exit status means*), where `dp`'s
# own statuses pass through unchanged:
#   0   completed
#   1   stopped on a business error (dp's)
#   2   stopped on a fundamental error: a setting this script needs missing, the
#       lock file missing, docker unable to run the container (its 125 to 127)
#   3   completed with errors, which the next run repeats (dp's)
#   64  usage error
#   70  unexpected error: dp's, or an exit status docker passes on that is none
#       of the above, such as a kill's 137
#   75  temporary failure: dp's, the docker daemon is unreachable, or a run of
#       the same job is live already (the container's name is taken); retry
#
# There is no pivot of its own: the job in the container has it
# (docs/5.1.1 *Restarts and recovery*), and this script changes nothing.

set -euo pipefail

usage() {
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed -e '$d' -e 's/^# \{0,1\}//'
}

short_usage() {
    echo "usage: dp-run SUBCOMMAND [ARGUMENT...]; dp-run --help lists the statuses" >&2
}

die() {
    local status=$1
    shift
    echo "dp-run: $*" >&2
    exit "$status"
}

case "${1:-}" in
    -h | --help)
        usage
        exit 0
        ;;
    "")
        echo "dp-run: a subcommand is needed" >&2
        short_usage
        exit 64
        ;;
    -*)
        echo "dp-run: unknown option $1" >&2
        short_usage
        exit 64
        ;;
    hourly | collect | items | transform | export | daily | probe) ;;
    *)
        echo "dp-run: unknown subcommand $1" >&2
        short_usage
        exit 64
        ;;
esac
subcommand=$1
shift

need() {
    if [[ -z "${!1:-}" ]]; then
        die 2 "$1 is not set"
    fi
}
for variable in DP_IMAGE DP_ENV_FILE DP_RUN_USER DP_CONTAINER_MEMORY \
    DP_DATA_DIR DP_LOCK_FILE DP_BLIZZARD_CLIENT_SECRET_FILE; do
    need "$variable"
done

env_name=$(basename "$DP_ENV_FILE" .env)
if [[ ! "$env_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
    die 2 "DP_ENV_FILE is not <environment>.env: $DP_ENV_FILE"
fi

# The lock is a file the container opens, so it must exist to be mounted. A
# missing one is the install's to make, not a job's to make as root.
if [[ ! -f "$DP_LOCK_FILE" ]]; then
    die 2 "the lock file $DP_LOCK_FILE does not exist; make it as docs/5.3.2 says"
fi

name="dp-${subcommand}-${env_name}"
docker_args=(
    --rm --init
    --name "$name"
    --user "$DP_RUN_USER"
    --memory "$DP_CONTAINER_MEMORY" --memory-swap "$DP_CONTAINER_MEMORY"
    --read-only --tmpfs /tmp --cap-drop ALL
    --security-opt no-new-privileges
    --env-file "$DP_ENV_FILE"
    --volume "$DP_DATA_DIR:$DP_DATA_DIR"
    --volume "$DP_LOCK_FILE:$DP_LOCK_FILE"
    --volume "$DP_BLIZZARD_CLIENT_SECRET_FILE:$DP_BLIZZARD_CLIENT_SECRET_FILE:ro"
)
# `dp` reads the bucket's secret only where a bucket is set.
if [[ -n "${DP_BUCKET:-}" ]]; then
    need DP_BUCKET_ACCESS_FILE
    docker_args+=(--volume "$DP_BUCKET_ACCESS_FILE:$DP_BUCKET_ACCESS_FILE:ro")
fi

# Docker's own 125 cannot say an unreachable daemon from a run that failed, so
# ask first: the daemon being down is a blip, which the next run may find up.
if ! docker info > /dev/null 2>&1; then
    die 75 "the docker daemon is unreachable"
fi

# The container is named for its job and environment, so a run of the same job
# that is live holds the name: that is the lock's case, a blip, and not a
# failure to run. Ask before running, since docker's 125 for a name in use
# cannot be told from its other 125s. Only a running container counts; one that
# is left stopped is a fault for `docker run` to report as exit 2. The names
# are compared whole, not as docker's name filter matches them.
running=$(docker ps --format '{{.Names}}') || die 75 "docker could not list its containers"
while IFS= read -r running_name; do
    if [[ "$running_name" == "$name" ]]; then
        die 75 "a run of the same job is live already: $name"
    fi
done <<< "$running"

status=0
docker run "${docker_args[@]}" "$DP_IMAGE" "$subcommand" "$@" || status=$?

case "$status" in
    # dp's own statuses.
    0 | 1 | 2 | 3 | 64 | 70 | 75) exit "$status" ;;
    # docker could not run the container (125), or its command (126, 127).
    125 | 126 | 127) die 2 "docker could not run the container (status $status)" ;;
    # A kill (137, 143) or anything else is unexpected.
    *) die 70 "the container ended with status $status" ;;
esac
